#!/usr/bin/env bash

# oprun - A wrapper script to emulate `op run` using `op inject`
# Works around WSL issues where `op run` executes in Windows context
#
# Usage: oprun [OPTIONS] -- COMMAND [ARGS...]
#        oprun COMMAND [ARGS...]
#
# Examples:
#   oprun npm run start
#   oprun -- docker-compose up
#   oprun -e secrets.env -- python manage.py runserver
#   oprun --environment <id> -- printenv
#   oprun -h

set -e

# Default values
ENV_FILE=".env.template"
ENVIRONMENT=""
SHOW_HELP=false
NO_MASKING="${OP_RUN_NO_MASKING:-false}"
FORCE_MASKING=false
MASK_PLACEHOLDER="******"

# Color codes for output (only if terminal supports it)
if [[ -t 1 ]] && [[ "${TERM:-}" != "dumb" ]]; then
	RED='\033[0;31m'
	GREEN='\033[0;32m'
	YELLOW='\033[1;33m'
	BLUE='\033[0;34m'
	NC='\033[0m' # No Color
else
	RED=''
	GREEN=''
	YELLOW=''
	BLUE=''
	NC=''
fi

# Help message
show_help() {
	echo -e "
${BLUE}oprun${NC} - 1Password inject wrapper (WSL-friendly op run alternative)

${YELLOW}USAGE:${NC}
	oprun [OPTIONS] [--] COMMAND [ARGS...]

${YELLOW}OPTIONS:${NC}
	-e, --env-file FILE   Use specified env file (default: .env.template)
	-E, --environment ID  Load variables from a 1Password Environment (beta)
	    --mask            Force masking even on an interactive terminal
	    --no-masking      Do not mask secret values in the command's output
	-h, --help            Show this help message
	-v, --verbose         Show loaded environment variables (for debugging)

${YELLOW}EXAMPLES:${NC}
	oprun npm run start
	oprun -- docker-compose up
	oprun -e secrets.env -- python manage.py runserver
	oprun --environment <environment-id> -- printenv
	oprun --no-masking -- env
	oprun -v npm run test

${YELLOW}MASKING:${NC}
	Secret values resolved from 1Password are replaced with
	'${MASK_PLACEHOLDER}' when the command's output is redirected
	(piped or written to a file). On an interactive terminal the command
	runs unmasked so full-screen/TUI programs work normally.
	Force masking on a terminal with --mask.
	Disable masking entirely with --no-masking or OP_RUN_NO_MASKING=true.

${YELLOW}ENV FILE FORMAT:${NC}
	Create a .env.template file with 1Password secret references:
	
	DATABASE_URL="op://vault-name/item-name/field-name"
	API_KEY="op://student-services-prod/API Key: External Service/password"
	
${YELLOW}SETUP:${NC}
	1. Make sure 1Password CLI is installed and authenticated
	2. Create a .env.template file in your project
	3. Run: oprun your-command
"
}

# Parse command line arguments
VERBOSE=false
while [[ $# -gt 0 ]]; do
	case $1 in
		-h|--help)
			show_help
			exit 0
			;;
		-e|--env-file)
			ENV_FILE="$2"
			shift 2
			;;
		-E|--environment)
			ENVIRONMENT="$2"
			shift 2
			;;
		--no-masking)
			NO_MASKING=true
			shift
			;;
		--mask)
			FORCE_MASKING=true
			shift
			;;
		-v|--verbose)
			VERBOSE=true
			shift
			;;
		--)
			shift
			break
			;;
		-*)
			echo -e "${RED}Error: Unknown option $1${NC}" >&2
			echo "Use -h or --help for usage information" >&2
			exit 1
			;;
		*)
			# First non-option argument, assume it's the start of the command
			break
			;;
	esac
done

# Check if we have a command to run
if [[ $# -eq 0 ]]; then
	echo -e "${RED}Error: No command specified${NC}" >&2
	echo "Use -h or --help for usage information" >&2
	exit 1
fi

# Check if env file exists (only required when no Environment is provided)
if [[ -z "$ENVIRONMENT" ]] && [[ ! -f "$ENV_FILE" ]]; then
	echo -e "${RED}Error: Env file '$ENV_FILE' not found${NC}" >&2
	echo -e "${YELLOW}Create an env file with your 1Password secret references:${NC}" >&2
	echo 'DATABASE_URL="op://vault-name/item-name/field-name"' >&2
	echo 'API_KEY="op://vault-name/item-name/password"' >&2
	echo -e "${YELLOW}Or load variables from a 1Password Environment with --environment ID${NC}" >&2
	exit 1
fi

# Check if op CLI is available, with fallback to op.exe (for WSL)
OP_CMD="op"
if ! command -v op &> /dev/null; then
	if command -v op.exe &> /dev/null; then
		OP_CMD="op.exe"
		echo -e "${YELLOW}Using Windows 1Password CLI (op.exe) from WSL${NC}"
	else
		echo -e "${RED}Error: 1Password CLI not found${NC}" >&2
		echo "Tried: 'op' and 'op.exe'" >&2
		echo "Please install 1Password CLI: https://developer.1password.com/docs/cli/get-started/" >&2
		exit 1
	fi
fi

# Check if user is signed in to 1Password
if ! $OP_CMD account list &> /dev/null; then
	echo -e "${RED}Error: Not signed in to 1Password${NC}" >&2
	echo "Please run: $OP_CMD signin" >&2
	exit 1
fi

env_vars=""

# Load variables from the env file (if present)
if [[ -f "$ENV_FILE" ]]; then
	echo -e "${BLUE}Loading secrets from $ENV_FILE...${NC}"
	if ! env_file_vars=$($OP_CMD inject -i "$ENV_FILE" 2>/dev/null); then
		echo -e "${RED}Error: Failed to inject secrets from 1Password${NC}" >&2
		echo "Check your env file and 1Password references" >&2
		exit 1
	fi
	env_vars="$env_file_vars"
fi

# Load variables from a 1Password Environment
if [[ -n "$ENVIRONMENT" ]]; then
	echo -e "${BLUE}Loading secrets from 1Password Environment $ENVIRONMENT...${NC}"
	if ! environment_vars=$($OP_CMD environment read "$ENVIRONMENT" 2>/dev/null); then
		echo -e "${RED}Error: Failed to read 1Password Environment '$ENVIRONMENT'${NC}" >&2
		echo "Check the Environment ID" >&2
		exit 1
	fi
	env_vars="${env_vars}${env_vars:+$'\n'}${environment_vars}"
fi

# Build the list of secret values that must be masked in the command output
declare -a SECRET_KEYS=()
declare -a MASK_VALUES=()
declare -a MASK_PATTERNS=()
declare -A RESOLVED_VARS=()

# Index the resolved variables by name
while IFS= read -r line || [[ -n "$line" ]]; do
	line="${line%$'\r'}"
	if [[ "$line" == *"="* ]]; then
		key="${line%%=*}"
		value="${line#*=}"
		value="${value%\"}"; value="${value#\"}"
		value="${value%\'}"; value="${value#\'}"
		RESOLVED_VARS["$key"]="$value"
	fi
done <<< "$env_vars"

# Keys from the env file whose value is a 1Password secret reference
if [[ -f "$ENV_FILE" ]]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%$'\r'}"
		if [[ "$line" == *"="* ]]; then
			key="${line%%=*}"
			key="${key//[[:space:]]/}"
			value="${line#*=}"
			if [[ -n "$key" ]] && [[ "$value" == *"op://"* ]]; then
				SECRET_KEYS+=("$key")
			fi
		fi
	done < "$ENV_FILE"
fi

# Every variable returned from a 1Password Environment is treated as a secret
if [[ -n "$ENVIRONMENT" ]]; then
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%$'\r'}"
		if [[ "$line" == *"="* ]]; then
			key="${line%%=*}"
			key="${key//[[:space:]]/}"
			if [[ -n "$key" ]]; then
				SECRET_KEYS+=("$key")
			fi
		fi
	done <<< "$environment_vars"
fi

# Resolve the identified keys to their secret values
for key in "${SECRET_KEYS[@]}"; do
	value="${RESOLVED_VARS[$key]:-}"
	if [[ -n "$value" ]]; then
		MASK_VALUES+=("$value")
	fi
done

# Sort values longest-first so overlapping secrets are masked correctly
if (( ${#MASK_VALUES[@]} > 1 )); then
	for ((i = 0; i < ${#MASK_VALUES[@]}; i++)); do
		for ((j = i + 1; j < ${#MASK_VALUES[@]}; j++)); do
			if (( ${#MASK_VALUES[j]} > ${#MASK_VALUES[i]} )); then
				tmp="${MASK_VALUES[i]}"
				MASK_VALUES[i]="${MASK_VALUES[j]}"
				MASK_VALUES[j]="$tmp"
			fi
		done
	done
fi

# Escape glob metacharacters so masking performs literal replacement
for value in "${MASK_VALUES[@]}"; do
	pattern=$(printf '%s' "$value" | sed 's/[][*?\\]/\\&/g')
	MASK_PATTERNS+=("$pattern")
done

# Replace every occurrence of a secret value with the placeholder
mask_stream() {
	local line pattern
	while IFS= read -r line || [[ -n "$line" ]]; do
		for pattern in "${MASK_PATTERNS[@]}"; do
			line="${line//$pattern/$MASK_PLACEHOLDER}"
		done
		printf '%s\n' "$line"
	done
}

# Export the injected variables into the current environment
load_env_vars() {
	local line trimmed
	while IFS= read -r line || [[ -n "$line" ]]; do
		line="${line%$'\r'}"
		trimmed="${line#"${line%%[![:space:]]*}"}"
		if [[ -z "$trimmed" ]] || [[ "${trimmed:0:1}" == "#" ]]; then
			continue
		fi
		if [[ "$trimmed" == *"="* ]]; then
			export "$trimmed"
		fi
	done <<< "$env_vars"
}

# Show loaded variables if verbose mode is enabled
if [[ "$VERBOSE" == "true" ]]; then
	echo -e "${GREEN}Loaded environment variables:${NC}"
	echo "$env_vars" | sed 's/=.*/=***/' | sed 's/^/  /'
	echo
fi

echo -e "${GREEN}Executing command with injected secrets...${NC}"

# Masking requires piping the command's output through a filter, which breaks
# full-screen/TUI programs because stdout and stderr are no longer a terminal.
# Only mask when the output is redirected (piped or written to a file), unless
# masking is explicitly forced with --mask.
USE_MASKING=false
if [[ "$NO_MASKING" != "true" ]] && [[ ${#MASK_PATTERNS[@]} -gt 0 ]]; then
	if [[ "$FORCE_MASKING" == "true" ]] || [[ ! -t 1 ]]; then
		USE_MASKING=true
	fi
fi

# Execute the command with injected environment variables
# Using a subshell to avoid polluting the current environment
if [[ "$USE_MASKING" == "true" ]]; then
	# Merge stdout and stderr, masking secret values as they stream
	set +e
	(
		load_env_vars
		"$@"
	) 2>&1 | mask_stream
	exit_code=${PIPESTATUS[0]}
	exit "$exit_code"
else
	# Pass the terminal through untouched so interactive/TUI commands work
	(
		load_env_vars
		exec "$@"
	)
fi
